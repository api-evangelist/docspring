        {
          "id": "73a0467e-65a1-4d49-90ee-2700f2bcd609",
          "name": "Generate multiple PDFs",
          "request": {
            "name": "Generate multiple PDFs",
            "description": {
              "content": "Generates up to 50 PDFs in a single request. Each submission can use a different template\nand data. Supports both synchronous (wait for all PDFs) and asynchronous processing. More\nefficient than individual requests when creating multiple PDFs.\n\nSee also:\n- [Batch and Combine PDFs](https://docspring.com/docs/api-guide/generate-pdfs/batch-generate-pdfs/) - Generate and merge PDFs in one request\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "submissions",
                "batches"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "description": {
                    "content": "Wait for submission batch to be processed before returning. Set to false to return immediately. Default: true (on sync.* subdomain)",
                    "type": "text/plain"
                  },
                  "key": "wait",
                  "value": ""
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"submissions\": [\n    {\n      \"css\": \"<string>\",\n      \"data\": \"<object>\",\n      \"html\": \"<string>\",\n      \"metadata\": \"<object>\",\n      \"template_id\": \"<string,null>\",\n      \"template_version\": \"<string,null>\",\n      \"test\": \"<boolean>\"\n    },\n    {\n      \"css\": \"<string>\",\n      \"data\": \"<object>\",\n      \"html\": \"<string>\",\n      \"metadata\": \"<object>\",\n      \"template_id\": \"<string,null>\",\n      \"template_version\": \"<string,null>\",\n      \"test\": \"<boolean>\"\n    }\n  ],\n  \"metadata\": \"<object>\",\n  \"template_id\": \"<string,null>\",\n  \"template_version\": \"<string,null>\",\n  \"test\": \"<boolean>\"\n}",
              "options": {
