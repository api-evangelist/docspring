          "id": "ee639c9c-0fcd-4ef4-a1db-0fd0667f9598",
          "name": "Create a new custom file from a cached S3 upload",
          "request": {
            "name": "Create a new custom file from a cached S3 upload",
            "description": {
              "content": "The Custom Files API endpoint allows you to upload PDFs to DocSpring and then\nmerge them with other PDFs. First upload your file using the presigned URL endpoint,\nthen use the returned cache_id to create the custom file.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "custom_files"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cache_id\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "ad88c1eb-674f-4081-93fc-516357be61c4",
              "name": "returns the custom file",
              "originalRequest": {
                "url": {
                  "path": [
                    "custom_files"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: basic",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Basic <credentials>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"cache_id\": \"cfi_1234567890abcdef01.pdf\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
