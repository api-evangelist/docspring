      "item": [
        {
          "name": "Create a new custom file from a cached S3 upload",
          "id": "2fee4bbf-af8a-419c-8c8b-6675da2aaa66",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
